---
const mapEmbedUrl = "https://www.google.com/maps?q=25.6571393,-100.3100316&z=16&output=embed";
const mapOpenUrl = "https://www.google.com/maps/place/25.6571393,-100.3100316";
---

<section class="section-card max-w-5xl mx-auto">
  <h2 class="text-2xl font-bold text-center">Nuestra ubicación</h2>
  <p class="mt-2 text-center text-sm">Visítanos o agenda una cita para asesorarte en tu proyecto.</p>
  <iframe
    class="mt-5 h-96 w-full rounded-xl"
    style="border:0"
    loading="lazy"
    allowfullscreen
    title="Ubicación Breccia Mármol"
    referrerpolicy="no-referrer-when-downgrade"
    src={mapEmbedUrl}
  ></iframe>
  <div class="mt-4 text-center">
    <a href={mapOpenUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
      Abrir en Google Maps
    </a>
  </div>
</section>

