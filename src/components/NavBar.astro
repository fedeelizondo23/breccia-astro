---
const { user } = Astro.props;
const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Inicio" },
  { href: "/about", label: "Nosotros" },
  { href: "/products", label: "Productos" },
  { href: "/faq", label: "FAQ" },
  { href: "/contact", label: "Contacto" },
];

const isActive = (href) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<nav class="sticky top-0 z-40 border-b border-stone-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="text-lg font-bold tracking-tight text-stone-900 sm:text-xl">
      Breccia Mármol
    </a>

    <ul class="order-3 flex w-full flex-wrap items-center gap-2 text-sm font-medium text-stone-600 md:order-2 md:w-auto md:gap-6">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "nav-link rounded-md px-3 py-2 transition",
              isActive(link.href)
                ? "nav-link-active bg-stone-900 text-white"
                : "hover:bg-stone-100 hover:text-stone-900",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="order-2 flex items-center gap-2 md:order-3">
      <button
        id="theme-toggle-btn"
        type="button"
        class="theme-switch"
        aria-pressed="false"
        aria-label="Cambiar tema"
        title="Cambiar tema"
      >
        <span class="theme-switch-track" aria-hidden="true">
          <span class="theme-switch-knob">
            <!-- Sun icon (light mode) -->
            <svg class="theme-icon theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18ZM7.166 17.834a.75.75 0 0 0-1.06 1.06l1.59 1.591a.75.75 0 1 0 1.061-1.06l-1.59-1.591ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12ZM6.166 6.106a.75.75 0 0 0 1.06 1.06l-1.59-1.59a.75.75 0 0 0-1.061 1.06l1.59 1.59Z"/>
            </svg>
            <!-- Moon icon (dark mode) -->
            <svg class="theme-icon theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.7-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z" clip-rule="evenodd"/>
            </svg>
          </span>
        </span>
      </button>
      <div id="user-info"></div>
      {!user && (
        <>
          <a
            href="/login"
            id="login-btn"
            class="rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold text-stone-700 transition hover:bg-stone-100"
          >
            Iniciar sesión
          </a>
          <a
            href="/register"
            id="register-btn"
            class="rounded-lg bg-stone-900 px-3 py-2 text-sm font-semibold text-white transition hover:bg-stone-700"
          >
            Registrarse
          </a>
        </>
      )}
    </div>
  </div>
</nav>
