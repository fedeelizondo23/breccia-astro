---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Contacto">
  <section class="section-card mb-8 text-center">
    <h1 class="text-4xl font-bold">Contáctanos</h1>
    <p class="mx-auto mt-4 max-w-3xl text-base sm:text-lg">
      ¿Tienes dudas o necesitas cotización? Compártenos los detalles de tu proyecto
      y te respondemos a la brevedad.
    </p>
  </section>

  <section class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
    <div class="section-card">
      <h2 class="text-2xl font-semibold">Envíanos un mensaje</h2>
      <p class="mt-2 text-sm">Te contactamos con propuesta y tiempos estimados.</p>
        <form id="contact-form" class="space-y-4">
          <div>
            <label for="name" class="mb-2 block text-sm font-semibold text-stone-700">Nombre completo</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Ej. Juan Pérez"
              class="w-full rounded-lg border border-stone-300 px-4 py-3 text-sm"
              required
            />
          </div>

          <div>
            <label for="email" class="mb-2 block text-sm font-semibold text-stone-700">Correo electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="tu-correo@ejemplo.com"
              class="w-full rounded-lg border border-stone-300 px-4 py-3 text-sm"
              required
            />
          </div>

          <div>
            <label for="message" class="mb-2 block text-sm font-semibold text-stone-700">Mensaje</label>
            <textarea
              id="message"
              name="message"
              placeholder="Cuéntanos qué tipo de cubierta necesitas, medidas y ubicación."
              rows="4"
              class="w-full rounded-lg border border-stone-300 px-4 py-3 text-sm"
              required></textarea>
          </div>

          <button type="submit" class="btn-primary w-full">
            Enviar Mensaje
          </button>
        </form>
      </div>

    <aside class="section-card">
      <h2 class="text-2xl font-semibold">Canales de contacto</h2>
      <ul class="mt-4 space-y-3 text-sm text-stone-700">
        <li class="rounded-lg bg-stone-100 px-4 py-3">
          WhatsApp:
          <a href="https://wa.me/528113775574" class="ml-1 font-semibold text-stone-900 hover:underline">+52 81 1377 5574</a>
        </li>
        <li class="rounded-lg bg-stone-100 px-4 py-3">
          Instagram:
          <a href="https://instagram.com/brecciamarmol" class="ml-1 font-semibold text-stone-900 hover:underline">@brecciamarmol</a>
        </li>
        <li class="rounded-lg bg-stone-100 px-4 py-3">
          Facebook:
          <a href="https://www.facebook.com/breccia.marmol.7" class="ml-1 font-semibold text-stone-900 hover:underline">Breccia Mármol</a>
        </li>
        <li class="rounded-lg bg-stone-100 px-4 py-3">
          Correo:
          <a href="mailto:brecciamarmol@gmail.com" class="ml-1 font-semibold text-stone-900 hover:underline">brecciamarmol@gmail.com</a>
        </li>
      </ul>
      <p class="mt-5 rounded-lg border border-stone-200 bg-white px-4 py-3 text-sm">
        Horario sugerido de atención:<br />
        Lunes a viernes: 9:00 a 17:00<br />
        Sábado: 9:00 a 13:00
      </p>
    </aside>
  </section>

  <script>
    document
      .getElementById("contact-form")
      ?.addEventListener("submit", function (event) {
        event.preventDefault();
        alert(
          "Gracias por tu mensaje. Nos pondremos en contacto contigo pronto."
        );
        (event.target as HTMLFormElement).reset();
      });
  </script>
</Layout>
