---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";

// Imágenes de productos
import marbleImage from "@/marble.avif";
import graniteImage from "@/granite.avif";
import quartzImage from "@/quartz.avif";
import cuarcitaImage from "@/cuarcita.avif";

// Lista de productos
const products = [
  { name: "Mármol", description: "Elegancia y durabilidad para cualquier espacio.", image: marbleImage },
  { name: "Granito", description: "Resistencia y belleza en cada pieza.", image: graniteImage },
  { name: "Cuarzo", description: "Material moderno con acabados perfectos.", image: quartzImage },
  { name: "Cuarcita", description: "Fuerza y estética natural para tu hogar.", image: cuarcitaImage },
];
---

<Layout title="Productos">
  <section class="section-card mb-8 text-center">
    <h1 class="text-4xl font-bold">Nuestros Materiales</h1>
    <p class="mx-auto mt-4 max-w-3xl text-base sm:text-lg">
      Descubre nuestra selección de piedras naturales y superficies premium para cocinas, baños,
      mesas, asadores y proyectos comerciales.
    </p>
  </section>

  <section>
    <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {products.map((product) => (
        <article class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md">
          <Image src={product.image} alt={product.name} class="h-52 w-full object-cover" />
          <div class="p-5">
            <h3 class="text-xl font-semibold">{product.name}</h3>
            <p class="mt-2 text-sm">{product.description}</p>
            <a href="/contact" class="btn-primary mt-4 w-full">
              Solicitar cotización
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
