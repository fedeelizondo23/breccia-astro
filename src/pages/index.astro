---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import marbleImage from "@/marble.avif";
import graniteImage from "@/granite.avif";
import quartzImage from "@/quartz.avif";
import cuarcitaImage from "@/cuarcita.avif";
import Map from "../components/Map.astro";

const materials = [
  {
    title: "Mármol",
    description: "Elegancia natural para cocinas, baños y proyectos residenciales de alta gama.",
    image: marbleImage,
  },
  {
    title: "Granito",
    description: "Máxima resistencia al uso diario, ideal para superficies de trabajo exigentes.",
    image: graniteImage,
  },
  {
    title: "Cuarzo",
    description: "Acabado uniforme y moderno con gran durabilidad para interiores contemporáneos.",
    image: quartzImage,
  },
  {
    title: "Cuarcita",
    description: "Textura y carácter natural para espacios únicos con personalidad premium.",
    image: cuarcitaImage,
  },
];
---

<Layout title="Inicio" description="Especialistas en cubiertas de mármol, granito, cuarzo y cuarcita en México.">
  <section class="section-card mb-8 overflow-hidden sm:mb-10">
    <div class="grid items-center gap-8 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <span class="mb-4 inline-block rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-stone-700">
          Desde 1993
        </span>
        <h1 class="text-4xl font-bold sm:text-5xl">Cubiertas premium para transformar tus espacios</h1>
        <p class="mt-4 max-w-2xl text-base sm:text-lg">
          Diseñamos, fabricamos e instalamos superficies en mármol, granito, cuarzo y cuarcita con enfoque en calidad,
          detalle y durabilidad.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/products" class="btn-primary">Ver materiales</a>
          <a href="/contact" class="btn-secondary">Solicitar cotización</a>
        </div>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-stone-100 p-6">
        <h2 class="text-xl font-semibold">¿Qué hacemos?</h2>
        <ul class="mt-4 space-y-3 text-sm text-stone-700">
          <li>• Cubiertas para cocinas y barras</li>
          <li>• Lavabos y mobiliario de baño</li>
          <li>• Cubiertas para mesas y asadores</li>
          <li>• Asesoría técnica y acabados a medida</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mb-10">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-bold">Materiales que trabajamos</h2>
        <p class="mt-2 text-sm sm:text-base">Seleccionamos cada pieza para asegurar estética, resistencia y larga vida útil.</p>
      </div>
      <a href="/products" class="btn-secondary">Ver catálogo completo</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {materials.map((material) => (
        <article class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md">
          <Image src={material.image} alt={material.title} class="h-52 w-full object-cover" />
          <div class="p-5">
            <h3 class="text-lg font-semibold">{material.title}</h3>
            <p class="mt-2 text-sm">{material.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-card mb-10">
    <div class="grid gap-6 md:grid-cols-3">
      <div>
        <h3 class="text-lg font-semibold">Atención personalizada</h3>
        <p class="mt-2 text-sm">Te guiamos desde la selección del material hasta la instalación final.</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold">Instalación profesional</h3>
        <p class="mt-2 text-sm">Procesos limpios, tiempos claros y acabados de precisión.</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold">Garantía de calidad</h3>
        <p class="mt-2 text-sm">Trabajamos con materiales confiables para proyectos durables.</p>
      </div>
    </div>
  </section>

  <Map />
</Layout>
